{
  "manifest_version": 3,
  "name": "Revisão de Texto com IA",
  "version": "0.1.0",
  "key": "",
  "description": "Revisão ortográfica, gramatical e de clareza (PT-BR e inglês) com Claude. Só envia texto quando você aciona a revisão.",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting", "unlimitedStorage", "nativeMessaging"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "*://*.caiomga.com/*",
    "*://*.substack.com/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Revisão de Texto com IA",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "review": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Revisar o texto selecionado ou o campo em foco"
    }
  }
}
